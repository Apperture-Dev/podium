# Server-only — never exposed to the browser (no NEXT_PUBLIC_ prefix). The
# browser only ever talks to this Next.js app's own /api/* routes; Keycloak
# and the Symfony API are called from the server side of those routes and
# from the login Server Action. See src/lib/auth/config.ts.

# Local docker compose (services/php/compose.yaml) — same host/ports the
# backend's own README uses.
KEYCLOAK_URL=http://localhost:8091
KEYCLOAK_REALM=podium
KEYCLOAK_CLIENT_ID=podium-web

# Used only by /register to create the user via Keycloak's Admin REST API
# (admin-cli, master realm) — dev-only shortcut, the realm's default admin/admin.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

SYMFONY_API_BASE_URL=http://localhost:8090
